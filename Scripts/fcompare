#!/bin/bash
# fcompare — open a comparison in FileComparator.
#   fcompare left right            two-way compare (files or folders)
#   fcompare left base right       three-way merge
#   fcompare --paste [3]           empty panes to paste text into (2 or 3 panes)
# Set FCOMPARE_NOWAIT=1 to return immediately instead of waiting for the window to close.
# git difftool:  git config --global difftool.fcompare.cmd 'fcompare "$LOCAL" "$REMOTE"'
set -euo pipefail
paste_mode=""
if [ "${1:-}" = "--paste" ] || [ "${1:-}" = "--blank" ]; then
  paste_mode="${2:-2}"
  set --
elif [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: fcompare <left> [<base>] <right>   |   fcompare --paste [3]" >&2
  exit 64
fi
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
app="${FCOMPARE_APP:-}"
if [ -z "$app" ]; then
  candidate="$(cd "$(dirname "$self")/../.." 2>/dev/null && pwd)"
  if [ -d "$candidate/Contents/MacOS" ]; then app="$candidate"
  elif [ -d "/Applications/FileComparator.app" ]; then app="/Applications/FileComparator.app"
  elif [ -d "$HOME/Applications/FileComparator.app" ]; then app="$HOME/Applications/FileComparator.app"
  else echo "fcompare: FileComparator.app not found (set FCOMPARE_APP)" >&2; exit 69
  fi
fi
args=()
if [ -n "$paste_mode" ]; then args=(--blank "$paste_mode"); fi
for p in "$@"; do
  if [ ! -e "$p" ]; then echo "fcompare: no such file or directory: $p" >&2; exit 66; fi
  args+=("$(cd "$(dirname "$p")" && pwd)/$(basename "$p")")
done
if [ "${FCOMPARE_NOWAIT:-0}" = "1" ] || [ -n "$paste_mode" ]; then
  open -n -a "$app" --args "${args[@]}"
else
  open -n -W -a "$app" --args "${args[@]}"
fi
